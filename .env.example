# Copy to backend/.env for local runs. On Render, set these in the service's Environment tab.
# Never commit real values.

# --- MongoDB Atlas ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=gtm_strategy_dev

# --- Auth --- (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=
JWT_EXPIRY_HOURS=72

# --- Google Gemini --- (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Main model; if it is missing or overloaded the app tries GEMINI_FALLBACK_MODELS, then the newest Flash models.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite
AGENT_MAX_TOKENS=32000

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
# Allow Vercel preview deployments, e.g. ^https://gtm-strategy-[a-z0-9-]+\.vercel\.app$
CORS_ORIGIN_REGEX=

# --- Crawler limits ---
CRAWL_MAX_PAGES=25
CRAWL_TIMEOUT_SECONDS=10
CRAWL_TOTAL_BUDGET_SECONDS=120
CRAWL_MAX_BYTES=2000000
CRAWL_CONCURRENCY=4

# --- Crawler fallbacks ---
# Reader that renders JavaScript-heavy or bot-protected pages. Empty string turns it off.
CRAWL_READER_URL=https://r.jina.ai/
# Optional: a Jina API key raises the reader's rate limit (free tier works without one).
JINA_API_KEY=
CRAWL_READER_MAX_PAGES=12
CRAWL_GUESS_PATHS=true
